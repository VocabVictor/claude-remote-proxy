# Copy to .claude-remote-proxy.env on your Linux/WSL client.
# Values are literal; use absolute paths, not $HOME or ~.
CLAUDE_PROXY_MODE=remote
SSH_TARGET=company-server
REMOTE_USER=your-user
REMOTE_PROJECT_DIR=/home/your-user/project
REMOTE_PROXY_BIN=/home/your-user/.local/bin/claude-remote-proxy-native
REMOTE_CLAUDE_BIN=/home/your-user/.local/bin/claude
REMOTE_TMUX_SESSION=claude-company-project
CLAUDE_PERMISSION_MODE=standard
SSH_CONTROL_PERSIST=8h
# Optional A/B tests; unset means inherit OpenSSH configuration.
# SSH_COMPRESSION=no
# SSH_IP_QOS=none
# SSH_CIPHERS=aes128-gcm@openssh.com
# OpenSSH >=9.5: disables keystroke-timing masking, exposing typing timing.
# SSH_OBSCURE_KEYSTROKE_TIMING=no
