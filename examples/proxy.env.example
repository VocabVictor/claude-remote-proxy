# Copy this file to <your-project>/.claude-remote-proxy.env.
# This file is sourced by Bash. Keep it private and do not commit it.

# The SSH account may be root when the actual Claude process must run as a
# different unprivileged user.
SSH_TARGET="root@example-host"
REMOTE_USER="remote-developer"

# Use an absolute path owned by REMOTE_USER. Underscores are supported; the
# proxy converts the path to Claude Code's hyphenated project key when it
# installs the session context.
REMOTE_PROJECT_DIR="/home/remote-developer/work/my-project"

# standard: normal Claude Code permission prompts
# bypass:   passes --dangerously-skip-permissions (trusted sandboxes only)
CLAUDE_PERMISSION_MODE="standard"

# Optional. If omitted, the newest session for the local project is used.
# CLAUDE_SESSION_ID="00000000-0000-0000-0000-000000000000"

# Optional. The SSH master remains available after the interactive channel
# exits, so status/sync/reconnect reuse one TCP connection.
SSH_CONTROL_PERSIST="15m"
