#!/usr/bin/env bash

set -Eeuo pipefail

VERSION="0.2.0"
PROGRAM="${0##*/}"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

log() {
  printf '[proxy] %s\n' "$*" >&2
}

usage() {
  cat <<'EOF'
Usage: claude-remote-proxy <command>

Commands:
  connect       Open the persistent SSH control connection
  status        Report connection and remote prerequisites (never logs in)
  sync          First-time import, or an explicit later workspace sync
  run           Create once or attach to the same remote Claude process
  start         Bootstrap if needed, otherwise attach without syncing
  disconnect    Close SSH; the remote Claude process keeps running
  encode-path   Print Claude Code's project-directory key for a path
  version       Print the version

Configuration is loaded from .claude-remote-proxy.env in the project root.
Copy examples/proxy.env.example from this repository to get started.
Set CLAUDE_PROXY_MODE=remote for existing server projects (no file upload).
EOF
}

encode_path() {
  # Claude Code currently maps every non-alphanumeric/non-hyphen path byte to '-'.
  LC_ALL=C sed 's/[^A-Za-z0-9-]/-/g' <<<"$1"
}

single_quote() {
  local value=${1//\'/\'"\'"\'}
  printf "'%s'" "$value"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

validate_safe_token() {
  local label=$1 value=$2
  [[ $value =~ ^[A-Za-z0-9._@:-]+$ ]] || die "$label contains unsupported characters: $value"
}

validate_safe_path() {
  local label=$1 value=$2
  [[ $value == /* ]] || die "$label must be an absolute path: $value"
  [[ $value =~ ^/[A-Za-z0-9._/-]+$ ]] || die "$label contains unsupported characters: $value"
}

PROJECT_DIR="${CLAUDE_PROXY_PROJECT_DIR:-$PWD}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"
CONFIG_FILE="${CLAUDE_PROXY_CONFIG:-$PROJECT_DIR/.claude-remote-proxy.env}"

if [[ -f $CONFIG_FILE ]]; then
  # The config is shell syntax and must be trusted like any other project script.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

SSH_TARGET="${SSH_TARGET:-}"
REMOTE_USER="${REMOTE_USER:-}"
REMOTE_PROJECT_DIR="${REMOTE_PROJECT_DIR:-}"
CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CLAUDE_SESSION_ID="${CLAUDE_SESSION_ID:-}"
CLAUDE_PERMISSION_MODE="${CLAUDE_PERMISSION_MODE:-standard}"
SSH_CONTROL_PERSIST="${SSH_CONTROL_PERSIST:-8h}"
CLAUDE_PROXY_MODE="${CLAUDE_PROXY_MODE:-import}"
REMOTE_CLAUDE_BIN="${REMOTE_CLAUDE_BIN:-claude}"

target_hash() {
  printf '%s' "$SSH_TARGET" | shasum | cut -c1-12
}

configure() {
  require_command ssh
  require_command shasum
  [[ -n $SSH_TARGET ]] || die "SSH_TARGET is required in $CONFIG_FILE"
  [[ -n $REMOTE_USER ]] || die "REMOTE_USER is required in $CONFIG_FILE"
  [[ -n $REMOTE_PROJECT_DIR ]] || die "REMOTE_PROJECT_DIR is required in $CONFIG_FILE"
  validate_safe_token SSH_TARGET "$SSH_TARGET"
  validate_safe_token REMOTE_USER "$REMOTE_USER"
  validate_safe_path REMOTE_PROJECT_DIR "$REMOTE_PROJECT_DIR"
  case "$CLAUDE_PERMISSION_MODE" in
    standard|bypass) ;;
    *) die "CLAUDE_PERMISSION_MODE must be 'standard' or 'bypass'" ;;
  esac
  case "$CLAUDE_PROXY_MODE" in
    import|remote) ;;
    *) die "CLAUDE_PROXY_MODE must be 'import' or 'remote'" ;;
  esac
  [[ -n $REMOTE_CLAUDE_BIN ]] || die "REMOTE_CLAUDE_BIN must not be empty"
  REMOTE_TMUX_SESSION="${REMOTE_TMUX_SESSION:-claude-proxy-$(printf '%s' "$REMOTE_PROJECT_DIR" | shasum | cut -c1-12)}"
  validate_safe_token REMOTE_TMUX_SESSION "$REMOTE_TMUX_SESSION"
  CONTROL_SOCKET="${CLAUDE_PROXY_SOCKET:-/tmp/claude-proxy-${UID}-$(target_hash).sock}"
}

ssh_base() {
  ssh -S "$CONTROL_SOCKET" "$@"
}

master_is_running() {
  ssh -S "$CONTROL_SOCKET" -O check "$SSH_TARGET" >/dev/null 2>&1
}

connect_master() {
  configure
  if master_is_running; then
    log "persistent SSH connection: already running"
    return
  fi
  rm -f "$CONTROL_SOCKET"
  log "opening persistent SSH connection to $SSH_TARGET"
  ssh -M -S "$CONTROL_SOCKET" \
    -o "ControlPersist=$SSH_CONTROL_PERSIST" \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -fN "$SSH_TARGET"
  master_is_running || die "SSH control connection did not start"
}

remote_root() {
  ssh_base -T "$SSH_TARGET" "$@"
}

remote_as_user() {
  local inner=$1 user_q inner_q
  user_q=$(single_quote "$REMOTE_USER")
  inner_q=$(single_quote "$inner")
  remote_root "if [ \"\$(id -un)\" = $user_q ]; then exec bash -lc $inner_q; else exec su - $user_q -c $inner_q; fi"
}

# The project already lives on the server. Do all preparation in one SSH
# channel: no local session import, rsync, recursive chown, or status probes.
run_remote_project() {
  connect_master
  local script user_q script_q
  script="$(cat <<'REMOTE'
set -euo pipefail
cd "$project"
command -v tmux >/dev/null
command -v "$claude_bin" >/dev/null
command -v flock >/dev/null
state_dir="$HOME/.claude/remote-proxy"
mkdir -p "$state_dir"
chmod 700 "$state_dir"
state="$state_dir/$session.session-id"
exec 9>"$state.lock"
flock -x 9
if [[ -s $state ]]; then
  uuid=$(cat "$state")
else
  uuid=$(cat /proc/sys/kernel/random/uuid)
  (umask 077; printf '%s\n' "$uuid" > "$state")
fi
[[ $uuid =~ ^[0-9A-Fa-f-]{36}$ ]] || exit 1
key=$(LC_ALL=C sed 's/[^A-Za-z0-9-]/-/g' <<< "$project")
args=("$claude_bin")
[[ $permission != bypass ]] || args+=(--dangerously-skip-permissions)
if [[ -f "$HOME/.claude/projects/$key/$uuid.jsonl" ]]; then
  args+=(--resume "$uuid")
else
  args+=(--session-id "$uuid")
fi
printf -v launch '%q ' "${args[@]}"
flock -u 9
exec 9>&-
# -A attaches if it exists, otherwise creates it atomically in tmux.
exec tmux new-session -A -s "$session" -c "$project" "$launch"
REMOTE
)"
  script="project=$(single_quote "$REMOTE_PROJECT_DIR")
session=$(single_quote "$REMOTE_TMUX_SESSION")
permission=$(single_quote "$CLAUDE_PERMISSION_MODE")
claude_bin=$(single_quote "$REMOTE_CLAUDE_BIN")
$script"
  user_q=$(single_quote "$REMOTE_USER")
  script_q=$(single_quote "$script")
  exec ssh -tt -S "$CONTROL_SOCKET" "$SSH_TARGET" \
    "if [ \"\$(id -un)\" = $user_q ]; then exec bash -lc $script_q; else exec su - $user_q -s /bin/bash -c $script_q; fi"
}

remote_home() {
  local home
  home=$(remote_root "getent passwd $(single_quote "$REMOTE_USER") | cut -d: -f6")
  [[ -n $home ]] || die "remote user does not exist: $REMOTE_USER"
  validate_safe_path remote_home "$home"
  printf '%s\n' "$home"
}

remote_state_file() {
  printf '%s/.claude/remote-proxy/%s.session-id\n' "$(remote_home)" "$REMOTE_TMUX_SESSION"
}

remote_session_is_initialized() {
  remote_root "test -s $(single_quote "$(remote_state_file)")"
}

remote_session_id() {
  local state_file session_id
  state_file=$(remote_state_file)
  session_id=$(remote_root "test -s $(single_quote "$state_file") && cat $(single_quote "$state_file") || true")
  [[ -n $session_id ]] || die "remote session is not initialized; run '$PROGRAM sync' first"
  [[ $session_id =~ ^[0-9A-Fa-f-]{36}$ ]] || die "invalid remote session state in $state_file"
  printf '%s\n' "$session_id"
}

remote_tmux_is_running() {
  remote_as_user "tmux has-session -t $(single_quote "$REMOTE_TMUX_SESSION") 2>/dev/null"
}

status() {
  connect_master
  local project_state claude_path claude_version tmux_path process_state session_state
  project_state=$(remote_root "if test -d $(single_quote "$REMOTE_PROJECT_DIR"); then printf present; else printf missing; fi")
  claude_path=$(remote_as_user "command -v claude || true")
  if [[ -n $claude_path ]]; then
    claude_version=$(remote_as_user "claude --version 2>/dev/null || true")
  else
    claude_version="not installed"
  fi
  tmux_path=$(remote_as_user "command -v tmux || true")
  if [[ -z $tmux_path ]]; then
    process_state="tmux not installed"
  elif remote_tmux_is_running; then
    process_state="running; next start will attach"
  else
    process_state="not running"
  fi
  if remote_session_is_initialized; then
    session_state=$(remote_session_id)
  else
    session_state="not imported"
  fi

  cat <<EOF
connection: connected (persistent SSH master)
host: $SSH_TARGET
remote user: $REMOTE_USER
remote project: $REMOTE_PROJECT_DIR ($project_state)
remote claude: $claude_version
authentication: untouched; this tool never runs login
permission mode: $CLAUDE_PERMISSION_MODE
remote tmux: $REMOTE_TMUX_SESSION ($process_state)
remote session: $session_state
EOF
}

local_session_file() {
  local local_key local_dir selected
  local_key=$(encode_path "$PROJECT_DIR")
  local_dir="$CLAUDE_CONFIG_DIR/projects/$local_key"

  if [[ -n $CLAUDE_SESSION_ID ]]; then
    selected="$local_dir/$CLAUDE_SESSION_ID.jsonl"
    [[ -f $selected ]] || die "Claude session not found: $selected"
    printf '%s\n' "$selected"
    return
  fi

  selected=$(ls -1t "$local_dir"/*.jsonl 2>/dev/null | head -n 1 || true)
  [[ -n $selected ]] || die "no Claude session found under $local_dir; set CLAUDE_SESSION_ID if needed"
  printf '%s\n' "$selected"
}

prepare_remote_project() {
  local group
  group=$(remote_root "id -gn $(single_quote "$REMOTE_USER")")
  remote_root "install -d -o $(single_quote "$REMOTE_USER") -g $(single_quote "$group") $(single_quote "$REMOTE_PROJECT_DIR")"
}

sync_workspace() {
  require_command rsync
  prepare_remote_project
  log "syncing workspace to $SSH_TARGET:$REMOTE_PROJECT_DIR"
  rsync -rlptDz \
    --exclude=.claude-remote-proxy.env \
    --exclude=.DS_Store \
    -e "ssh -S $CONTROL_SOCKET" \
    "$PROJECT_DIR/" "$SSH_TARGET:$REMOTE_PROJECT_DIR/"

  local group
  group=$(remote_root "id -gn $(single_quote "$REMOTE_USER")")
  remote_root "chown -R $(single_quote "$REMOTE_USER"):$(single_quote "$group") $(single_quote "$REMOTE_PROJECT_DIR")"
}

sync_session() {
  require_command rsync
  local session_file session_id remote_user_home remote_key remote_dir group state_dir state_file remote_jsonl
  remote_user_home=$(remote_home)
  state_dir="$remote_user_home/.claude/remote-proxy"
  state_file="$state_dir/$REMOTE_TMUX_SESSION.session-id"

  if remote_session_is_initialized; then
    session_id=$(remote_session_id)
    log "remote session already initialized: $session_id (context import skipped)"
    printf '%s\n' "$session_id"
    return
  fi

  session_file=$(local_session_file)
  session_id=${session_file##*/}
  session_id=${session_id%.jsonl}
  [[ $session_id =~ ^[0-9A-Fa-f-]{36}$ ]] || die "session filename is not a UUID: $session_id"
  remote_key=$(encode_path "$REMOTE_PROJECT_DIR")
  remote_dir="$remote_user_home/.claude/projects/$remote_key"
  remote_jsonl="$remote_dir/$session_id.jsonl"
  group=$(remote_root "id -gn $(single_quote "$REMOTE_USER")")

  remote_root "install -d -o $(single_quote "$REMOTE_USER") -g $(single_quote "$group") $(single_quote "$remote_dir") $(single_quote "$state_dir")"
  if remote_root "test -f $(single_quote "$remote_jsonl")"; then
    log "remote JSONL already exists; preserving its newer history"
  else
    log "importing Claude session $session_id exactly once"
    rsync -rlptDz -e "ssh -S $CONTROL_SOCKET" "$session_file" "$SSH_TARGET:$remote_dir/"
  fi

  local local_key local_memory
  local_key=$(encode_path "$PROJECT_DIR")
  local_memory="$CLAUDE_CONFIG_DIR/projects/$local_key/memory"
  if [[ -d $local_memory ]]; then
    log "importing Claude project memory"
    rsync -rlptDz -e "ssh -S $CONTROL_SOCKET" "$local_memory/" "$SSH_TARGET:$remote_dir/memory/"
  fi
  remote_root "printf '%s\\n' $(single_quote "$session_id") > $(single_quote "$state_file") && chown -R $(single_quote "$REMOTE_USER"):$(single_quote "$group") $(single_quote "$remote_dir") $(single_quote "$state_dir")"
  printf '%s\n' "$session_id"
}

sync_all() {
  connect_master
  if remote_tmux_is_running; then
    die "refusing to sync over a running remote Claude process; attach to it instead"
  fi
  sync_workspace
  local session_id
  session_id=$(sync_session)
  log "sync complete; session: $session_id"
}

run_remote() {
  connect_master
  local session_id claude_inner tmux_inner user_q inner_q tmux_path
  tmux_path=$(remote_as_user "command -v tmux || true")
  [[ -n $tmux_path ]] || die "tmux is required on the remote machine to preserve one Claude process"
  session_id=$(remote_session_id)

  if remote_tmux_is_running; then
    tmux_inner="exec tmux attach-session -t $(single_quote "$REMOTE_TMUX_SESSION")"
    log "attaching to existing remote Claude process: $REMOTE_TMUX_SESSION"
  else
    claude_inner="cd $(single_quote "$REMOTE_PROJECT_DIR") && exec claude"
    if [[ $CLAUDE_PERMISSION_MODE == bypass ]]; then
      claude_inner+=" --dangerously-skip-permissions"
    fi
    # Reuse the imported UUID. --fork-session is intentionally forbidden: it
    # would create a different conversation on every wrapper invocation.
    claude_inner+=" --resume $(single_quote "$session_id")"
    tmux_inner="exec tmux new-session -s $(single_quote "$REMOTE_TMUX_SESSION") $(single_quote "$claude_inner")"
    log "starting the persistent remote Claude process once: $REMOTE_TMUX_SESSION"
  fi
  user_q=$(single_quote "$REMOTE_USER")
  inner_q=$(single_quote "$tmux_inner")

  log "terminal attached through tmux; detaching SSH does not end Claude"
  log "this tool will not answer login or trust prompts for you"
  exec ssh -tt -S "$CONTROL_SOCKET" "$SSH_TARGET" "su - $user_q -c $inner_q"
}

disconnect_master() {
  configure
  if master_is_running; then
    ssh -S "$CONTROL_SOCKET" -O exit "$SSH_TARGET" >/dev/null
    log "persistent SSH connection closed"
  else
    log "persistent SSH connection is not running"
  fi
}

main() {
  local command=${1:-}
  case "$command" in
    connect) connect_master ;;
    status) status ;;
    sync)
      [[ $CLAUDE_PROXY_MODE != remote ]] || die "sync is disabled in remote mode; the server owns the workspace"
      sync_all ;;
    run)
      if [[ $CLAUDE_PROXY_MODE == remote ]]; then run_remote_project; else run_remote; fi ;;
    start)
      if [[ $CLAUDE_PROXY_MODE == remote ]]; then
        run_remote_project
        return
      fi
      status
      if remote_session_is_initialized; then
        log "remote session already exists; skipping workspace and context sync"
      else
        sync_all
      fi
      run_remote
      ;;
    disconnect) disconnect_master ;;
    encode-path)
      [[ $# -eq 2 ]] || die "encode-path requires exactly one path"
      encode_path "$2"
      ;;
    version|--version|-V) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
    help|--help|-h|'') usage ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"
